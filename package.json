{
  "name": "dsh-git-branch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在 DSH 对话里切换或新建 Git 分支，可为非 Git 目录初始化仓库，控件位置可选。",
  "keywords": [
    "dsh",
    "git"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
